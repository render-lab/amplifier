{
  "name": "amplifier",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/render-lab/amplifier.git"
  },
  "homepage": "https://github.com/render-lab/amplifier#readme",
  "bugs": {
    "url": "https://github.com/render-lab/amplifier/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Posts an amplify note to Slack when a Render post goes live on X or LinkedIn.",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "trigger:serve": "node dist/webhook-server.js",
    "stub": "tsx scripts/typefully-stub.ts",
    "local:run": "tsx scripts/local-run.ts",
    "webhook:post": "tsx scripts/webhook-post.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@render-lab/tasks-core": "0.3.0",
    "@render-lab/tasks-llm": "0.8.1",
    "@render-lab/tasks-render-kv": "0.3.0",
    "@render-lab/tasks-slack": "0.3.0",
    "@render-lab/triggers": "0.2.0",
    "@renderinc/sdk": "1.0.0",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@render-lab/test-utils": "0.1.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.0"
  }
}
